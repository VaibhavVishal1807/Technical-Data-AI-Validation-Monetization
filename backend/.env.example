# Copy this file to backend/.env and adjust. Every value is optional:
# the defaults below are used when a value is missing.

# --- Server -------------------------------------------------------------
# Called API_PORT (not PORT) so it never clashes with the frontend dev server.
# If you change it, start the frontend with the same API_PORT so its proxy follows.
API_PORT=4000
# 127.0.0.1 = only this machine can connect. Use 0.0.0.0 to expose on your network.
HOST=127.0.0.1

# --- Auth ---------------------------------------------------------------
# Secret used to sign login tokens (JWT). Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a random secret is generated at startup (logins reset on restart).
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Data ---------------------------------------------------------------
# Path to the monitoring CSV (default: ../data/Case_Study_3_Pure_Insights_Monitoring.csv)
DATA_PATH=
# The CSV has no dates; the newest snapshot is mapped to this month (YYYY-MM).
LATEST_PERIOD=2026-09

# --- Cost ---------------------------------------------------------------
# Assumed Snowflake price per credit in USD.
CREDIT_PRICE_USD=3

# --- Alerting -----------------------------------------------------------
LATENCY_WARNING_SEC=15
LATENCY_CRITICAL_SEC=30
# After notifying about a report, stay quiet about the same alert type for
# that report for this many of its next snapshots (stops flapping alerts).
ALERT_COOLDOWN_SNAPSHOTS=3

# --- Telemetry replay ---------------------------------------------------
# One CSV row is streamed as "live" telemetry every N milliseconds.
REPLAY_INTERVAL_MS=500
REPLAY_AUTOSTART=true
# Start again from the first row after the last one.
REPLAY_LOOP=true
